# Configurações do Sistema STI
PORT=8080
HOST=127.0.0.1

# Horários de envio automático (separados por vírgula)
REPORT_HOURS=8,12,16

# Configurações de E-mail (Opcional - preencha se desejar envio por SMTP)
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@exemplo.gov.br
SMTP_PASS=sua_senha_de_app
EMAIL_TO=destinatario1@exemplo.gov.br,destinatario2@exemplo.gov.br

# Webhook para Mensageria (WhatsApp, Telegram, Teams, Discord)
WEBHOOK_URL=

# Credenciais de Integração dos Sistemas
SEI_URL=https://sip.sei.ma.gov.br/sip/login.php?sigla_orgao_sistema=GOVMA&sigla_sistema=SEI&infra_url=L3NlaS8=
SEI_USER=seu_cpf_ou_usuario_sei
SEI_PASS=sua_senha_sei

STARTGOV_URL=https://bid.startgov.com.br/login
STARTGOV_USER=seu_cpf_ou_usuario_startgov
STARTGOV_PASS=sua_senha_startgov
